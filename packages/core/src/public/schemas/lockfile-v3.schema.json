{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AmadeusITGroup/ai-primitives-hub/schemas/lockfile-v3.schema.json",
  "title": "AI Primitives Hub Lockfile 3.x",
  "description": "Strict amended v3 role-split lockfile pair. Legacy identities are accepted only as migration evidence.",
  "oneOf": [
    { "$ref": "#/definitions/desiredState" },
    { "$ref": "#/definitions/localState" }
  ],
  "definitions": {
    "desiredState": {
      "type": "object",
      "required": ["$schema", "version", "bundles", "sources"],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://github.com/AmadeusITGroup/ai-primitives-hub/schemas/lockfile-v3.schema.json"
        },
        "version": { "type": "string", "pattern": "^3\\.\\d+\\.\\d+$" },
        "bundles": {
          "type": "object",
          "propertyNames": { "pattern": "^src-[a-f0-9]{64}/[^/]+$" },
          "additionalProperties": { "$ref": "#/definitions/desiredEntry" }
        },
        "sources": {
          "type": "object",
          "propertyNames": { "pattern": "^src-[a-f0-9]{64}$" },
          "additionalProperties": { "$ref": "#/definitions/sourceEntry" }
        },
        "unresolved": {
          "type": "array",
          "items": { "$ref": "#/definitions/legacyDesiredIntent" }
        },
        "hubs": { "type": "object" },
        "profiles": { "type": "object" }
      }
    },
    "localState": {
      "type": "object",
      "required": ["version", "generatedAt", "generatedBy", "targets"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^3\\.\\d+\\.\\d+$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generatedBy": { "type": "string", "minLength": 1 },
        "migration": {
          "type": "object",
          "required": ["lockfileV3"],
          "additionalProperties": false,
          "properties": { "lockfileV3": { "const": "complete" } }
        },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/targetRecord" }
        }
      }
    },
    "desiredEntry": {
      "type": "object",
      "required": ["version", "sourceKey", "resolution"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceKey": { "$ref": "#/definitions/sourceKey" },
        "resolution": { "$ref": "#/definitions/resolution" }
      }
    },
    "sourceKey": {
      "type": "string",
      "pattern": "^src-[a-f0-9]{64}$"
    },
    "sourceEntry": {
      "oneOf": [
        { "$ref": "#/definitions/githubReleaseSource" },
        { "$ref": "#/definitions/githubTreeSource" },
        { "$ref": "#/definitions/azureDevOpsSource" },
        { "$ref": "#/definitions/artifactorySource" },
        { "$ref": "#/definitions/localSource" }
      ]
    },
    "githubReleaseSource": {
      "type": "object",
      "required": ["type", "identity", "locator"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "github" },
        "identity": { "$ref": "#/definitions/githubReleaseIdentity" },
        "locator": { "$ref": "#/definitions/remoteLocator" },
        "config": { "$ref": "#/definitions/sourceConfig" }
      }
    },
    "githubTreeSource": {
      "type": "object",
      "required": ["type", "identity", "locator"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["skills", "awesome-copilot"] },
        "identity": { "$ref": "#/definitions/githubTreeIdentity" },
        "locator": { "$ref": "#/definitions/remoteLocator" },
        "config": { "$ref": "#/definitions/sourceConfig" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "skills" } }, "required": ["type"] },
          "then": { "properties": { "identity": { "not": { "required": ["collectionsPath"] } } } },
          "else": { "properties": { "identity": { "not": { "required": ["skillsPath"] } } } }
        }
      ]
    },
    "azureDevOpsSource": {
      "type": "object",
      "required": ["type", "identity", "locator"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "azure-devops" },
        "identity": { "$ref": "#/definitions/azureDevOpsIdentity" },
        "locator": { "$ref": "#/definitions/remoteLocator" },
        "config": { "$ref": "#/definitions/sourceConfig" }
      }
    },
    "artifactorySource": {
      "type": "object",
      "required": ["type", "identity", "locator"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "artifactory" },
        "identity": { "$ref": "#/definitions/artifactoryIdentity" },
        "locator": { "$ref": "#/definitions/remoteLocator" },
        "config": { "$ref": "#/definitions/sourceConfig" }
      }
    },
    "localSource": {
      "type": "object",
      "required": ["type", "identity", "locator"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["local", "local-awesome-copilot", "local-skills"] },
        "identity": {
          "oneOf": [
            { "$ref": "#/definitions/workspaceLocalIdentity" },
            { "$ref": "#/definitions/externalLocalIdentity" }
          ]
        },
        "locator": { "type": "string", "minLength": 1 },
        "config": { "$ref": "#/definitions/sourceConfig" }
      },
      "allOf": [
        {
          "if": { "properties": { "identity": { "properties": { "kind": { "const": "workspace-local" } } } } },
          "then": { "properties": { "locator": { "$ref": "#/definitions/portableRelativeRoot" } } }
        },
        {
          "if": { "properties": { "identity": { "properties": { "kind": { "const": "external-local" } } } } },
          "then": { "properties": { "locator": { "$ref": "#/definitions/bindingName" } } }
        },
        {
          "if": { "properties": { "type": { "const": "local-skills" } }, "required": ["type"] },
          "then": { "properties": { "identity": { "not": { "required": ["collectionsPath"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "local-awesome-copilot" } }, "required": ["type"] },
          "then": { "properties": { "identity": { "not": { "required": ["skillsPath"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "local" } }, "required": ["type"] },
          "then": {
            "properties": {
              "identity": {
                "not": {
                  "anyOf": [
                    { "required": ["collectionsPath"] },
                    { "required": ["skillsPath"] }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "sourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "collectionsPath": { "$ref": "#/definitions/relativePath" },
        "skillsPath": { "$ref": "#/definitions/relativePath" },
        "indexFile": { "$ref": "#/definitions/relativePath" },
        "authMode": { "enum": ["anonymous", "bearer"] },
        "credentialRef": { "type": "string", "minLength": 1 }
      }
    },
    "githubReleaseIdentity": {
      "type": "object",
      "required": ["kind", "origin", "repositoryId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "github-releases" },
        "origin": { "$ref": "#/definitions/providerOrigin" },
        "repositoryId": { "$ref": "#/definitions/githubId" }
      }
    },
    "githubTreeIdentity": {
      "type": "object",
      "required": ["kind", "origin", "repositoryId", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "github-tree" },
        "origin": { "$ref": "#/definitions/providerOrigin" },
        "repositoryId": { "$ref": "#/definitions/githubId" },
        "ref": { "type": "string", "minLength": 1 },
        "collectionsPath": { "$ref": "#/definitions/relativePath" },
        "skillsPath": { "$ref": "#/definitions/relativePath" }
      }
    },
    "azureDevOpsIdentity": {
      "type": "object",
      "required": ["kind", "namespace", "repositoryId", "ref", "collectionsPath"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "azure-devops-tree" },
        "namespace": { "type": "string", "minLength": 1 },
        "repositoryId": { "$ref": "#/definitions/azureRepositoryId" },
        "ref": { "type": "string", "minLength": 1 },
        "collectionsPath": { "$ref": "#/definitions/relativePath" }
      }
    },
    "artifactoryIdentity": {
      "type": "object",
      "required": ["kind", "root", "indexFile"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "artifactory-index" },
        "root": { "$ref": "#/definitions/remoteLocator" },
        "indexFile": { "$ref": "#/definitions/relativePath" }
      }
    },
    "workspaceLocalIdentity": {
      "type": "object",
      "required": ["kind", "root"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "workspace-local" },
        "root": { "$ref": "#/definitions/portableRelativeRoot" },
        "collectionsPath": { "$ref": "#/definitions/relativePath" },
        "skillsPath": { "$ref": "#/definitions/relativePath" }
      }
    },
    "externalLocalIdentity": {
      "type": "object",
      "required": ["kind", "bindingName"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "external-local" },
        "bindingName": { "$ref": "#/definitions/bindingName" },
        "collectionsPath": { "$ref": "#/definitions/relativePath" },
        "skillsPath": { "$ref": "#/definitions/relativePath" }
      }
    },
    "providerOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/@]+/?$"
    },
    "remoteLocator": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#@]+(?:/[^?#]*)?$"
    },
    "githubId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "azureRepositoryId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*://)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "portableRelativeRoot": {
      "type": "string",
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*://)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+)$"
    },
    "bindingName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?![A-Za-z]:)[^/\\\\\\u0000]+$"
    },
    "resolution": {
      "oneOf": [
        { "$ref": "#/definitions/githubReleaseResolution" },
        { "$ref": "#/definitions/githubTreeResolution" },
        { "$ref": "#/definitions/azureDevOpsResolution" },
        { "$ref": "#/definitions/artifactoryResolution" },
        { "$ref": "#/definitions/localSnapshotResolution" },
        { "$ref": "#/definitions/unpinnedResolution" },
        { "$ref": "#/definitions/liveResolution" }
      ]
    },
    "githubReleaseResolution": {
      "type": "object",
      "required": ["kind", "provider", "version", "releaseId", "assetId", "archiveSha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "pinned" },
        "provider": { "const": "github-release" },
        "version": { "type": "string", "minLength": 1 },
        "releaseId": { "$ref": "#/definitions/githubId" },
        "assetId": { "$ref": "#/definitions/githubId" },
        "archiveSha256": { "$ref": "#/definitions/sha256" },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "githubTreeResolution": {
      "type": "object",
      "required": ["kind", "provider", "version", "commitSha", "bundlePath", "sourceContentSha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "pinned" },
        "provider": { "const": "github-tree" },
        "version": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "bundlePath": { "$ref": "#/definitions/relativePath" },
        "sourceContentSha256": { "$ref": "#/definitions/sha256" },
        "externalInputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/externalInputPin" }
        }
      }
    },
    "azureDevOpsResolution": {
      "type": "object",
      "required": ["kind", "provider", "version", "commitId", "collectionPath", "sourceContentSha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "pinned" },
        "provider": { "const": "azure-devops-tree" },
        "version": { "type": "string", "minLength": 1 },
        "commitId": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "collectionPath": { "$ref": "#/definitions/relativePath" },
        "sourceContentSha256": { "$ref": "#/definitions/sha256" },
        "externalInputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/externalInputPin" }
        }
      }
    },
    "artifactoryResolution": {
      "type": "object",
      "required": ["kind", "provider", "version", "manifestPath", "manifestSize", "manifestSha256", "archivePath", "archiveSize", "archiveSha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "pinned" },
        "provider": { "const": "artifactory-object" },
        "version": { "type": "string", "minLength": 1 },
        "manifestPath": { "$ref": "#/definitions/relativePath" },
        "manifestSize": { "type": "integer", "minimum": 0 },
        "manifestSha256": { "$ref": "#/definitions/sha256" },
        "archivePath": { "$ref": "#/definitions/relativePath" },
        "archiveSize": { "type": "integer", "minimum": 0 },
        "archiveSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "localSnapshotResolution": {
      "type": "object",
      "required": ["kind", "provider", "version", "bundleSelector", "sourceContentSha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "pinned" },
        "provider": { "const": "local-snapshot" },
        "version": { "type": "string", "minLength": 1 },
        "bundleSelector": { "$ref": "#/definitions/relativePath" },
        "sourceContentSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "unpinnedResolution": {
      "type": "object",
      "required": ["kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "unpinned" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/definitions/unpinnedEvidence" }
      }
    },
    "unpinnedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knownPins": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!.*(?:token|password|secret|credential|authorization|api[_-]?key)).+$"
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "knownDigests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "archiveSha256": { "$ref": "#/definitions/sha256" },
            "sourceContentSha256": { "$ref": "#/definitions/sha256" },
            "manifestSha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "manifestVersion": { "type": "string", "minLength": 1 },
        "externalInputLimitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "liveResolution": {
      "type": "object",
      "required": ["kind", "selector"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "live" },
        "selector": { "$ref": "#/definitions/relativePath" }
      }
    },
    "externalInputPin": {
      "type": "object",
      "required": ["identity", "sourceContentSha256"],
      "additionalProperties": false,
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "sourceContentSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "legacyDesiredIntent": {
      "type": "object",
      "required": ["originalKey", "version", "reason"],
      "additionalProperties": false,
      "properties": {
        "originalKey": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "descriptor": { "$ref": "#/definitions/legacySourceDescriptorEvidence" },
        "version": { "type": "string", "minLength": 1 },
        "knownResolution": { "$ref": "#/definitions/resolution" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "legacyIdentityEvidence": {
      "type": "object",
      "required": ["originalKey", "version"],
      "additionalProperties": false,
      "properties": {
        "originalKey": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "descriptor": { "$ref": "#/definitions/legacySourceDescriptorEvidence" },
        "version": { "type": "string", "minLength": 1 },
        "knownResolution": { "$ref": "#/definitions/resolution" },
        "originalLocalRoot": { "type": "string", "minLength": 1 },
        "portableDescriptor": { "$ref": "#/definitions/sourceEntry" }
      }
    },
    "legacySourceDescriptorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:(?:https?://[^/?#@]+(?:/[^?#]*)?)|(?:\\.|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*://)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+))$"
        },
        "selectors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!.*(?:token|password|secret|credential|authorization|api[_-]?key)).+$"
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "targetRecord": {
      "type": "object",
      "required": ["baseDir", "bundles"],
      "additionalProperties": false,
      "properties": {
        "targetType": {
          "enum": ["vscode", "vscode-insiders", "copilot-cli", "kiro", "kiro-cli", "windsurf", "claude-code", "cursor", "opencode", "devin", "devin-cli"]
        },
        "scope": { "enum": ["user", "workspace", "repository"] },
        "baseDir": { "type": "string" },
        "commitMode": { "enum": ["commit", "local-only"] },
        "bundles": {
          "type": "object",
          "patternProperties": {
            "^src-[a-f0-9]{64}/[^/]+$": { "$ref": "#/definitions/activeBundleRecord" },
            "^unresolved/[a-f0-9]{64}$": { "$ref": "#/definitions/unresolvedMaterialization" }
          },
          "additionalProperties": false
        }
      }
    },
    "bundleRecord": {
      "oneOf": [
        { "$ref": "#/definitions/managedMaterialization" },
        { "$ref": "#/definitions/unmanagedMaterialization" }
      ]
    },
    "activeBundleRecord": {
      "oneOf": [
        { "$ref": "#/definitions/managedMaterialization" },
        {
          "allOf": [
            { "$ref": "#/definitions/unmanagedMaterialization" },
            { "required": ["sourceKey", "resolution"] }
          ]
        }
      ]
    },
    "unresolvedMaterialization": {
      "allOf": [
        { "$ref": "#/definitions/unmanagedMaterialization" },
        { "required": ["legacy"] },
        {
          "not": {
            "anyOf": [
              { "required": ["sourceKey"] },
              { "required": ["resolution"] }
            ]
          }
        }
      ]
    },
    "managedMaterialization": {
      "type": "object",
      "required": ["version", "sourceKey", "resolution", "installedAt", "files"],
      "additionalProperties": false,
      "not": { "required": ["state"] },
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceKey": { "$ref": "#/definitions/sourceKey" },
        "resolution": { "$ref": "#/definitions/resolution" },
        "installedAt": { "type": "string", "format": "date-time" },
        "commitMode": { "enum": ["commit", "local-only"] },
        "linked": { "const": true },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/fileEntry" }
        },
        "mcpConfigPath": { "type": "string", "minLength": 1 },
        "mcpServers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "complete": { "const": true },
        "legacy": { "$ref": "#/definitions/legacyIdentityEvidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "linked": { "const": true } }, "required": ["linked"] },
          "then": { "properties": { "files": { "items": { "$ref": "#/definitions/pathOnlyFileEntry" } } } },
          "else": { "properties": { "files": { "items": { "required": ["installedChecksum"] } } } }
        }
      ]
    },
    "unmanagedMaterialization": {
      "type": "object",
      "required": ["version", "installedAt", "files", "state", "unmanagedReason"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceKey": { "$ref": "#/definitions/sourceKey" },
        "resolution": { "$ref": "#/definitions/resolution" },
        "installedAt": { "type": "string", "format": "date-time" },
        "commitMode": { "enum": ["commit", "local-only"] },
        "state": { "const": "unmanaged" },
        "unmanagedReason": { "type": "string", "minLength": 1 },
        "linked": { "const": true },
        "files": { "type": "array", "items": { "$ref": "#/definitions/fileEntry" } },
        "mcpConfigPath": { "type": "string", "minLength": 1 },
        "mcpServers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "complete": { "const": true },
        "legacy": { "$ref": "#/definitions/legacyIdentityEvidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "linked": { "const": true } }, "required": ["linked"] },
          "then": { "properties": { "files": { "items": { "$ref": "#/definitions/pathOnlyFileEntry" } } } }
        }
      ],
      "oneOf": [
        { "required": ["sourceKey", "resolution"] },
        {
          "required": ["legacy"],
          "not": {
            "anyOf": [
              { "required": ["sourceKey"] },
              { "required": ["resolution"] }
            ]
          }
        }
      ]
    },
    "fileEntry": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "checksum": { "$ref": "#/definitions/fileChecksum" },
        "installedChecksum": { "$ref": "#/definitions/fileChecksum" },
        "adoptedAtMigration": { "const": true }
      }
    },
    "pathOnlyFileEntry": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        }
      }
    },
    "fileChecksum": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+:)?[a-f0-9]{64}$"
    }
  }
}
